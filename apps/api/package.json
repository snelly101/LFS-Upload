{
  "name": "@snelson/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:seed": "tsx src/cli.ts seed",
    "bootstrap-admin": "tsx src/cli.ts bootstrap-admin",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/server": "14.0.3",
    "@snelson/shared": "workspace:*",
    "@tus/file-store": "2.1.1",
    "@tus/server": "2.4.6",
    "archiver": "8.0.0",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.8",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "pino-pretty": "13.2.0",
    "smtp-server": "3.21.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
