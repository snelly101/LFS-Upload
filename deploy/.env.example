# Together Housing Secure File Send – deployment environment. Copy to deploy/.env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48

# ---- reverse proxy (Caddy) ----
PUBLIC_HOST=send.example.com
ACME_EMAIL=ops@example.com
# Certificate source for Caddy: acme (Let's Encrypt; needs public DNS + inbound 80/443),
# internal (Caddy's own CA, for LAN-only testing; trust its root on test devices), or custom (your own cert).
TLS_MODE=acme

# ---- application ----
# Public origin: used for links in email, cookies, OIDC redirect URI and the WebAuthn relying-party ID.
PUBLIC_URL=https://send.example.com
# 32+ bytes, base64. HMAC key for one-time codes/tokens and AES-256-GCM key for stored secrets
# (OIDC client secret, SMTP password, TOTP seeds). Rotating it invalidates stored TOTP seeds and secrets.
SERVER_SECRET_KEY=
# Database password (used by the db service and in DATABASE_URL built by compose).
POSTGRES_PASSWORD=
# Set true because the API sits behind Caddy/nginx (rate limits then use X-Forwarded-For).
TRUST_PROXY=true
LOG_LEVEL=info

# ---- malware scanner ----
# Must equal StreamMaxLength in deploy/clamd.conf (4000M = 4194304000 bytes). Larger files are
# reported as unscanned and blocked unless policy allows unscanned release.
CLAMD_MAX_STREAM_BYTES=4194304000
# Scan timeout per file (ms). 30 minutes default; raise for slow disks.
CLAMD_TIMEOUT_MS=1800000

# ---- email (SMTP is the only production transport) ----
MAIL_TRANSPORT=smtp
# Either configure SMTP in Administration → Notifications (stored encrypted) or set a URL here:
# smtps://user:pass@smtp.example.com:465  or  smtp://relay.internal:25
SMTP_URL=
SMTP_FROM="Together Housing Secure File Send <send@example.com>"

# ---- sessions: idle/absolute limits and the recent-authentication window are configured in
#      Administration → Identity & access (stored in the database), not here. ----

# ---- worker tuning ----
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=4
SCAN_CONCURRENCY=1
# How often active download streams are re-authorised (ms). Documented stop bound = 5 s.
STREAM_RECHECK_MS=2000

# ---- application image ----
# Leave empty to build the image on this host (deploy/upgrade.sh runs `docker compose build`).
# Set to a published image to pull instead of building, e.g. ghcr.io/snelly101/lfs-upload:1.2.0
# (built by .github/workflows/ci.yml). See docs/UPGRADE.md for the one-time `docker login ghcr.io`.
SECURESEND_IMAGE=

# ---- monitoring ----
# Bearer token for GET /statusz, used by deploy/monitor-check.sh (NinjaOne). Generated by
# deploy/install.sh and deploy/upgrade.sh when empty. With no token the endpoint answers 404.
# If you set your own it must be at least 24 characters (openssl rand -hex 32).
MONITOR_TOKEN=

# ---- backups (deploy/backup.sh, run nightly by deploy/systemd/securesend-backup.timer) ----
# Where database dumps are written. Never inside /srv/securesend/content.
BACKUP_DIR=/var/backups/securesend
# age PUBLIC key (age1...) to encrypt backups. Create the pair on an admin workstation with
# `age-keygen -o securesend-backup.key`; keep the private key in your secrets vault. Without this
# the dump is written unencrypted and deploy/backup.sh warns on every run.
BACKUP_AGE_RECIPIENT=
# Optional: path on THIS host to the age private key, so the monthly restore check can decrypt the
# real backup file. Leave empty to keep the private key off the server (the check then proves the
# dump/restore pipeline only; see docs/RUNBOOK-BACKUP-RESTORE.md).
BACKUP_AGE_IDENTITY_FILE=
# Retention: newest backup of each of the last N days, then of each of the M weeks before that.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Optional off-host copy of the ENCRYPTED files with rsync over SSH, e.g. backup@nas.internal:/backups/securesend
# (root's SSH key must be authorised there; unencrypted backups are never copied).
BACKUP_RSYNC_TARGET=
# deploy/monitor-check.sh reports a failure when the newest backup is older than this many hours.
BACKUP_MAX_AGE_HOURS=36

# ---- fixed by docker-compose.yml (do not set here): NODE_ENV, HOST, PORT, DATABASE_URL, CONTENT_ROOT,
#      CLAMD_HOST, CLAMD_PORT, WEB_DIST. DEV_SEED, MAIL_FILE_DIR and FAKE_SCANNER are development-only.
