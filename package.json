{
  "name": "securesend",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted secure large-file transfer application (working name: Together Housing Secure File Send)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @securesend/api run test",
    "test:e2e": "pnpm --filter @securesend/e2e run test",
    "dev:api": "pnpm --filter @securesend/api run dev",
    "dev:worker": "pnpm --filter @securesend/api run dev:worker",
    "dev:web": "pnpm --filter @securesend/web run dev",
    "db:migrate": "pnpm --filter @securesend/api run db:migrate",
    "db:seed": "pnpm --filter @securesend/api run db:seed",
    "bootstrap-admin": "pnpm --filter @securesend/api run bootstrap-admin"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2"
    ]
  }
}
